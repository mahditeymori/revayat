# Public — safe to ship to the browser.
NEXT_PUBLIC_SITE_URL=https://revayat.shop
NEXT_PUBLIC_WP_URL=https://cms.revayat.shop
NEXT_PUBLIC_ENAMAD_CODE=

# Server only. Never prefix with NEXT_PUBLIC_ — that would inline it into the JS bundle.
# Woo consumer key/secret are needed only for admin-side reads (wc/v3), not the storefront.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
