# Copy to .env.local for local development.
# postgres:16-alpine service defined in docker-compose.yml — see docker-compose.override.yml
# for the local dev port mapping.
DATABASE_URL=postgresql://revayat:revayat@localhost:5432/revayat

NEXT_PUBLIC_SITE_URL=https://revayat.shop
NEXT_PUBLIC_ENAMAD_CODE=

# Signs admin session tokens (lib/admin/session.ts) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me

# Zibal payment gateway (https://gateway.zibal.ir). The default below is
# Zibal's public sandbox merchant, safe to leave as-is until go-live.
ZIBAL_MERCHANT=zibal

# Local-disk media storage (lib/media/local-storage.ts). Must point at a
# path backed by a persistent Docker volume so uploads survive container
# replacement — see docker-compose.yml's `revayat_uploads` volume.
MEDIA_UPLOADS_DIR=./uploads
