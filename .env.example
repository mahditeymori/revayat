# Copy to .env and fill in. Never commit .env — it holds the admin password.

# Public origin of the deployed site. This value ends up in canonical tags,
# og:image URLs, sitemap.xml and robots.txt — if it is wrong (e.g. localhost),
# search engines cannot index the site. Must include the scheme, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://revayat.shop

# Enamad trust-seal code (Iranian e-commerce). Leave empty if not enrolled.
NEXT_PUBLIC_ENAMAD_CODE=

# Admin panel password. Use a long random value in production.
ADMIN_PASSWORD=change-me

# Zibal payment gateway merchant id (https://zibal.ir). SERVER-SIDE ONLY —
# never rename this to NEXT_PUBLIC_*, that would ship the credential to every
# visitor's browser.
#
# Use the literal value "zibal" to run against Zibal's sandbox: the full flow
# works end to end and no real money moves. Swap in your real merchant id for
# production. If this is empty, checkout shows a "gateway not configured" error
# rather than silently accepting orders as paid.
ZIBAL_MERCHANT=zibal
