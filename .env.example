NEXT_PUBLIC_SITE_URL=https://revayat.shop
NEXT_PUBLIC_ENAMAD_CODE=

# Postgres — provisioned by the `db` compose service, not an external host.
POSTGRES_USER=revayat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=revayat

# Signs admin session tokens.
ADMIN_SESSION_SECRET=change-me

# Zibal payment gateway. The value below is Zibal's public sandbox merchant.
ZIBAL_MERCHANT=zibal

# Pruning window for the `backup` service's scheduled pg_dump.
BACKUP_RETENTION_DAYS=14
